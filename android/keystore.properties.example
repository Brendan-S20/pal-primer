# Copy to android/keystore.properties (gitignored) and fill in. Never commit
# the copy, and keep the .jks itself OUTSIDE the repository directory.
#
# Generate the upload key once (keytool ships with the JDK):
#   keytool -genkeypair -v -keystore ~/keys/houndstack-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# Environment variables override this file when set:
#   ANDROID_KEYSTORE_PATH ANDROID_KEYSTORE_PASSWORD ANDROID_KEY_ALIAS ANDROID_KEY_PASSWORD
storeFile=/Users/you/keys/houndstack-upload.jks
storePassword=
keyAlias=upload
keyPassword=
