<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: https://app.houndstack.com STAFF pages open in the app.

                 The list below is an allowlist, and is tested against
                 src/lib/android-app-links.ts, which explains every exclusion:
                 customer links (/pay, /portal, /q, /track), anything that buys
                 HoundStack (/billing, /settings/billing, /settings/addons) and
                 /auth, the web OAuth redirect target, all stay in the browser.
                 Android before 15 cannot exclude a path inside a claimed
                 prefix, which is why Settings is listed page by page. Change
                 the TS list and this together;
                 tests/an-android-link-opens-the-app-only-where-it-should.test.ts
                 fails when they differ.

                 autoVerify makes Android fetch
                 https://app.houndstack.com/.well-known/assetlinks.json at
                 install. Until that file names Play's app signing certificate
                 (docs/play-store-submission.md, owner step), verification
                 fails and these links quietly open the browser instead, which
                 is the safe failure. The tap is handled in JS by
                 initAppLinks() in src/lib/native.ts. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="app.houndstack.com" />
                <data android:path="/" />
                <data android:path="/settings" />
                <data android:pathPrefix="/ai-tools" />
                <data android:pathPrefix="/analytics" />
                <data android:pathPrefix="/campaigns" />
                <data android:pathPrefix="/clients" />
                <data android:pathPrefix="/concerns" />
                <data android:pathPrefix="/dashboard" />
                <data android:pathPrefix="/disputes" />
                <data android:pathPrefix="/dna" />
                <data android:pathPrefix="/expenses" />
                <data android:pathPrefix="/franchise" />
                <data android:pathPrefix="/help" />
                <data android:pathPrefix="/imports" />
                <data android:pathPrefix="/inbox" />
                <data android:pathPrefix="/inventory" />
                <data android:pathPrefix="/invoices" />
                <data android:pathPrefix="/leads" />
                <data android:pathPrefix="/messages" />
                <data android:pathPrefix="/my-day" />
                <data android:pathPrefix="/my-schedule" />
                <data android:pathPrefix="/neighbors" />
                <data android:pathPrefix="/notifications" />
                <data android:pathPrefix="/onboarding" />
                <data android:pathPrefix="/payments" />
                <data android:pathPrefix="/pricing-drift" />
                <data android:pathPrefix="/profile" />
                <data android:pathPrefix="/properties" />
                <data android:pathPrefix="/quotes" />
                <data android:pathPrefix="/reports" />
                <data android:pathPrefix="/review" />
                <data android:pathPrefix="/routes" />
                <data android:pathPrefix="/setup" />
                <data android:pathPrefix="/tax-reports" />
                <data android:pathPrefix="/timesheets" />
                <data android:pathPrefix="/waste-log" />
                <data android:pathPrefix="/zones" />
                <data android:pathPrefix="/settings/accounting" />
                <data android:pathPrefix="/settings/ai" />
                <data android:pathPrefix="/settings/automation" />
                <data android:pathPrefix="/settings/blackouts" />
                <data android:pathPrefix="/settings/business" />
                <data android:pathPrefix="/settings/client-portal" />
                <data android:pathPrefix="/settings/deep-clean" />
                <data android:pathPrefix="/settings/emails" />
                <data android:pathPrefix="/settings/franchise" />
                <data android:pathPrefix="/settings/invoicing" />
                <data android:pathPrefix="/settings/lead-form" />
                <data android:pathPrefix="/settings/online-signup" />
                <data android:pathPrefix="/settings/payments" />
                <data android:pathPrefix="/settings/preferences" />
                <data android:pathPrefix="/settings/promotions" />
                <data android:pathPrefix="/settings/referrals" />
                <data android:pathPrefix="/settings/reviews" />
                <data android:pathPrefix="/settings/scheduling" />
                <data android:pathPrefix="/settings/services" />
                <data android:pathPrefix="/settings/skip-rules" />
                <data android:pathPrefix="/settings/sms" />
                <data android:pathPrefix="/settings/users" />
                <data android:pathPrefix="/settings/webhooks" />
            </intent-filter>

        </activity>

        <!-- Push notifications drawn by Firebase while the app is in the
             background, and by the Capacitor plugin in the foreground (it
             reads these same three keys).

             SMALL ICON: without this, Android draws the launcher icon as the
             status-bar glyph, and since Android 5 that is masked to its alpha
             channel: the full-colour hound-in-H becomes a solid white square.
             ic_stat_notification is a white-on-transparent vector, which is
             the only shape the status bar renders properly.

             CHANNEL: from Android 8 every notification needs one. With none
             named, Firebase files everything under a channel it calls
             "Miscellaneous". registerPushNotifications() creates "general"
             before registering, and this points FCM at it. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notificationAccent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions.
         The generated manifest ships with INTERNET and nothing else.

         SOME Capacitor plugins do bring their own and merge without help —
         @capacitor/haptics declares VIBRATE, @capacitor/network declares
         ACCESS_NETWORK_STATE, and firebase-messaging contributes WAKE_LOCK and
         c2dm.RECEIVE transitively. All four are in the built APK's merged
         manifest without being written here.

         The three this app most depends on declare NOTHING:
         @capacitor/camera, @capacitor/geolocation and
         @capacitor/push-notifications. Nothing will merge their permissions in
         for you, so they are declared explicitly below — and the failure mode
         if they are not is silent at build time and loud on a device.

         (An earlier version of this comment said all nine plugin manifests
         were empty. Three had been checked and the claim generalised to the
         rest; the APK disproved it. Enforced by
         tests/an-android-app-that-could-not-use-the-camera.test.ts.) -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- @capacitor/camera: completing a visit with a photo, and DNA samples. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Reading an existing photo. READ_MEDIA_IMAGES is the Android 13+ form;
         READ_EXTERNAL_STORAGE is capped below it for older devices. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- @capacitor/geolocation: "locate me" on the route map. COARSE as well as
         FINE because Android 12+ lets someone grant only the approximate one,
         and a route map is still useful at that precision. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- @capacitor/push-notifications. Required from Android 13 (API 33), and
         this app targets 36. Without it registration succeeds, delivery
         succeeds, and nothing is ever shown — the failure mode is silence. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The camera is not REQUIRED to use the product: an owner doing office
         work never opens it. Declaring it optional keeps the app installable
         on devices without one rather than having Play filter them out. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
</manifest>
