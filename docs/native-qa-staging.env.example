# Template for a staging native build. See docs/native-qa-staging.md.
#
# OPTIONAL ISOLATED PATH ONLY. Acceptance testing does not use this file: it
# runs against production (app.houndstack.com, or a production build:native
# bundle) signed into the production demo org (organizations.slug = 'demo',
# @demo.test accounts). No staging stack exists today.
#
# Copy this OUTSIDE the repo (e.g. ~/houndstack-native-staging.env) and fill
# it in. Never commit the filled-in copy. Placeholders only below: no real
# host, project ref or key belongs in this file.
#
# Load and build (macOS / Linux):
#   set -a; . ~/houndstack-native-staging.env; set +a
#   npm run build:native:staging && npx cap sync ios
#
# build:native:staging refuses to build if any value is missing or is a
# production value (vite.config.ts, #623/#663), and fails after the build if
# the bundle names any houndstack.com host (scripts/native-prod-hosts.mjs).

# The staging web app: a PRODUCTION build (npm run build) of the SAME commit
# you are building from, over HTTPS, on a host that is not *.houndstack.com.
# Every server function the binary calls goes here.
NATIVE_API_ORIGIN=https://staging-web-app.example

# The staging Supabase project. Must be the same project the staging web
# app's own SUPABASE_URL names, or sign-in works and every server call fails.
NATIVE_SUPABASE_URL=https://staging-project-ref.supabase.co

# That project's anon / publishable key. Not a secret (it ships inside the
# binary), but it is staging's and stays out of git. Set with the URL, always.
NATIVE_SUPABASE_PUBLISHABLE_KEY=replace-with-staging-anon-key
