# Copy to .env and fill in. .env is gitignored — it must never be committed.
#
# This file listed 9 variables while the code read 44. The ones it omitted
# included every Twilio, Stripe, email and push credential — so "what do I need
# to configure?" had no answer anywhere in the repo, and the way you found out a
# variable was missing was a feature failing in production. Two outages came
# from exactly that: email resolving against `undefined/functions/v1/...`, and
# the subscription catalog pointing at the wrong Stripe account.
#
# Everything below says WHERE it comes from and WHAT breaks without it. Optional
# entries say so; the rest are required for that feature to work at all.
#
# ── WHERE THESE GO ────────────────────────────────────────────────────────
#
# Production is served from Lovable, so runtime values belong in the Lovable
# project's environment settings — not in a file next to the code. The one
# exception is the Stripe catalog gate, which runs in GitHub Actions and needs
# its own restricted key (see STRIPE_SECRET_KEY).


# ── Supabase ──────────────────────────────────────────────────────────────
#
# SERVICE_ROLE_KEY is the one that matters: it bypasses every RLS policy in the
# database. Roughly 29 server-function modules need it, including getMyOrg,
# which guards the entire /_authenticated tree — without it, sign-in fails at
# the first server call.
SERVICE_ROLE_KEY=

SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=

# The VITE_ copies are inlined into the browser bundle at BUILD time. They are
# not secret, and they are NOT interchangeable with the names above: anything
# read on the server at runtime must use the non-VITE name, because
# `import.meta.env` is undefined there. That mistake took email down entirely.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=


# ── App origin ────────────────────────────────────────────────────────────
#
# Optional. src/lib/app-origin.ts hardcodes the production host and these only
# override it (APP_ORIGIN wins, then PUBLIC_APP_ORIGIN, then APP_URL — three
# names for one idea, kept because different subsystems already read different
# ones). Set for a preview deployment; leave unset in production.
#
# It must be the host that actually ANSWERS. A redirecting host silently drops
# the Authorization header, which surfaces as a 401 that looks like a bad
# credential and is not one.
APP_ORIGIN=

# Comma-separated extra origins allowed through CORS, for the Capacitor native
# shell (e.g. capacitor://localhost). Optional; web-only deployments need none.
NATIVE_CORS_ORIGINS=


# ── Stripe: the PLATFORM account (bills tenants for HoundStack) ───────────
#
# acct_1U0RifQjJFmqXgZD. Plans and add-ons live here.
#
# In GitHub Actions this must be a RESTRICTED key (rk_live_…) with read access
# on Prices and nothing else — the catalog gate makes exactly one call,
# GET /v1/prices. A full secret key does not belong in CI.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# From the webhook endpoint page in the Stripe dashboard, not the API keys page.
PLATFORM_STRIPE_WEBHOOK_SECRET=

# LEAVE THESE UNSET. They are an older naming that resolves to the same account
# as STRIPE_SECRET_KEY. Setting them creates two names for one account and a
# second place to keep in sync — which is how the catalog ended up built on the
# wrong account.
# PLATFORM_STRIPE_SECRET_KEY=
# PLATFORM_STRIPE_PUBLISHABLE_KEY=


# ── Stripe: the CONNECT account (tenants charge their own clients) ────────
#
# acct_1U0CVSQUHYdejlaV. Direct charges; the platform fee is taken from here.
#
# Price ids embed the owning account, product ids do not — so a price id copied
# between these two accounts fails with "No such price" at checkout, and nothing
# catches it until a real payment is attempted.
STRIPE_CONNECT_SECRET_KEY=
STRIPE_CONNECT_PUBLISHABLE_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=


# ── Twilio: the PLATFORM number (HoundStack → account holders) ────────────
#
# Outbound platform SMS does NOT use an account SID and auth token directly. It
# goes through the Lovable connector gateway, which needs both keys below.
LOVABLE_API_KEY=
TWILIO_API_KEY=

# The platform's own sender, in E.164 — currently +18668063017. Login codes,
# dunning notices and automated alerts send from here. Without it those paths
# fall back to a tenant's own number: the wrong brand on the wrong channel.
PLATFORM_SMS_FROM_NUMBER=

# Twilio Console → Account Info. This secures INBOUND: the webhook verifies
# Twilio's request signature with it.
#
# Set this and leave TWILIO_INBOUND_SECRET unset. The shared-secret path is a
# fallback carrying one platform-wide password in the webhook URL, where it
# lands in every access log the request passes through — and once it passes, the
# organization is taken from the caller-supplied `To` field.
TWILIO_AUTH_TOKEN=
# TWILIO_INBOUND_SECRET=

# Webhooks to set on the number (HTTP POST, form-encoded):
#   messages: https://app.houndstack.com/api/public/hooks/twilio
#   voice:    https://app.houndstack.com/api/public/hooks/twilio-voice
# No query string is needed once TWILIO_AUTH_TOKEN is set.
#
# Tenants using their OWN Twilio (BYOK) enter credentials in-app; those are
# encrypted at rest in org_twilio_credentials and never read from here.


# ── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=
# Resend dashboard → Webhooks. Verifies bounce/complaint callbacks, which is
# what makes a bounced address actually get suppressed.
RESEND_WEBHOOK_SECRET=
# Shared with the Supabase Auth hook so sign-in emails go through the same
# sender and templates as everything else.
AUTH_HOOK_SECRET=


# ── Scheduled jobs ────────────────────────────────────────────────────────
#
# Bearer token the pg_cron jobs present to the nightly / digest / email-queue
# endpoints. Those are public routes; this is what makes them not
# world-runnable.
CRON_SECRET=

# Direct Postgres connection string, used ONLY by the CI migration-drift check.
# Not needed at runtime.
SUPABASE_DB_URL=


# ── AI ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional — overrides the default model id in src/lib/ai.server.ts.
ANTHROPIC_MODEL=


# ── Push notifications ────────────────────────────────────────────────────
#
# Web push (VAPID). Generate once; changing them invalidates every existing
# browser subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A mailto: or https: URL identifying the sender to the push service.
VAPID_SUBJECT=

# Native push. Only needed once the iOS / Android builds ship.
APNS_AUTH_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_ENVIRONMENT=
# The whole service-account JSON from Firebase → Project settings → Service
# accounts → Generate new private key, pasted on one line. Replaces the legacy
# FCM_SERVER_KEY, whose endpoint Google decommissioned.
FCM_SERVICE_ACCOUNT=


# ── Accounting integrations (optional) ────────────────────────────────────
#
# Only needed if QuickBooks / Xero sync is offered. Absent, those screens report
# the integration as unconfigured rather than failing.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# "sandbox" or "production".
QBO_ENVIRONMENT=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=


# ── Maps / places ─────────────────────────────────────────────────────────
#
# Server-side address lookup and geocoding for zone matching.
GOOGLE_PLACES_API_KEY=
# Optional. Set, and src/lib/geocode.server.ts geocodes with Geocodio (US + Canada; imports and backfills as one batch request); unset, or on any Geocodio error, it uses OpenStreetMap Nominatim at 1 request/second.
GEOCODIO_API_KEY=
# Browser-side map rendering, inlined at build time via the Lovable connector.
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=
