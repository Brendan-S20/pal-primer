# Copy to .env and fill in. .env is gitignored — it must never be committed.
#
# SERVICE_ROLE_KEY is the one that matters: it bypasses every RLS policy in the
# database, so it belongs in the hosting provider's secret store (Vercel /
# Supabase project settings), not in a file next to the code. Roughly 29 of the
# server-function modules need it, including getMyOrg, which guards the entire
# /_authenticated tree — without it, sign-in fails at the first server call.
SERVICE_ROLE_KEY=

SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
